{
  "manifest_version": 3,
  "name": "会議録音・議事録（tabCapture）",
  "version": "1.0.0",
  "description": "会議タブの音声＋マイクをネイティブ録音し、ローカルの文字起こし・議事録バックエンドへ送ります（共有ダイアログ不要）。",
  "permissions": ["tabCapture", "offscreen", "storage", "activeTab"],
  "host_permissions": ["http://localhost:8000/*"],
  "action": {
    "default_title": "会議録音・議事録",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
