# ─────────────────────────────────────────────────────────────
# meeting_recorder — 環境変数サンプル
# このファイルを `.env.local` にコピーして値を埋めてください。
# ─────────────────────────────────────────────────────────────

# ── AI: Claude (任意) ────────────────────────────────────────
# 未設定の場合、UI に Claude プロバイダは表示されません。
ANTHROPIC_API_KEY=

# 既定モデル（省略時 claude-opus-4-8）
# CLAUDE_MODEL=claude-opus-4-8

# ── AI: Ollama (任意) ────────────────────────────────────────
# ローカル LLM。起動していれば UI に自動で表示されます。
# OLLAMA_BASE_URL=http://localhost:11434
# 既定モデル（省略時 Ollama の一覧の先頭）
# OLLAMA_MODEL=qwen2.5

# ── 文字起こし (faster-whisper) ──────────────────────────────
# 使用モデル。既定 large-v3-turbo（日本語精度と速度のバランス、約1.5GB）。
# 精度優先なら large-v3、速度優先なら medium に変更可。
# WHISPER_MODEL=large-v3-turbo
# 推論デバイス。auto なら CUDA があれば GPU、なければ CPU。
# WHISPER_DEVICE=auto
# CPU 推論時のスレッド数。既定は論理コア数（最大8）。
# WHISPER_CPU_THREADS=8
# バッチ推論（BatchedInferencePipeline）のバッチサイズ。既定 8。
# WHISPER_BATCH_SIZE=8
